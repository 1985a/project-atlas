state.Creative {
	control.1 {
		iface MIXER
		name 'Front Playback Volume'
		value.0 95
		value.1 95
		comment {
			access 'read write'
			type INTEGER
			count 2
			range '0 - 99'
			dbmin -9000
			dbmax 900
			dbvalue.0 500
			dbvalue.1 500
		}
	}
